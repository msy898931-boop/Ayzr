# ضع مفتاح مزوّد واحد هنا ليعمل التحليل الحقيقي (LIVE).
# بدون مفتاح، التطبيق يعمل بوضع DEMO التجريبي — وكل شي يشتغل عادي.
#
# سجّل مجاناً واحصل على مفتاح:
#   Gemini     → https://aistudio.google.com/apikey      (الأفضل للصور)
#   Groq       → https://console.groq.com/keys           (الأسرع)
#   OpenRouter → https://openrouter.ai/keys              (نماذج :free)
#
# انسخ هذا الملف باسم .env ثم الصق مفتاحك:

GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# اختياري: تجاوز اسم النموذج الافتراضي
# LLM_MODEL=gemini-3.5-flash

# ---------------------------------------------------------------------------
# الإنتاج (لا تضع هذه في التطوير)
# ---------------------------------------------------------------------------
# SECRET_KEY: إجباري عند TRADLI_ENV=production. بدونه يرفض التطبيق الإقلاع،
# لأن المفتاح العشوائي يُبطل كل الجلسات عند كل إعادة تشغيل. أنشئ واحداً بـ:
#   python -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=
# TRADLI_ENV=production

# TRUST_PROXY=true فقط خلف وكيل عكسي تتحكم به (Nginx/Cloudflare)، وإلا يستطيع
# أي عميل تزوير IP وتجاوز حدود الطلبات.
# TRUST_PROXY=false

# حدود الحماية (القيم الافتراضية معقولة)
# LOGIN_MAX_ATTEMPTS=8      # محاولات دخول فاشلة قبل القفل
# LOGIN_WINDOW=300          # نافذة العدّ (ثانية)
# LOGIN_LOCKOUT=900         # مدة القفل (ثانية)
# RATE_LIMIT_CALLS=60       # طلبات لكل IP
# RATE_LIMIT_WINDOW=60      # نافذة الحدّ (ثانية)

# حماية CSRF وحاجز نوع المحتوى (مفعّلة افتراضياً). لا تُطفئها إلا لعميل موثوق
# لا يستخدم الكوكيز:
# CSRF_PROTECT=true
# REQUIRE_JSON_CONTENT_TYPE=true

# سياسة كلمة السر ونطاقات البريد المحجوزة:
# PASSWORD_MIN_LENGTH=8
# BLOCKED_EMAIL_DOMAINS=example.com,example.org,example.net,test,invalid,localhost

# HSTS (يُرسل فقط في الإنتاج خلف TLS):
# HSTS_SECONDS=31536000

# بريد التواصل لـ /.well-known/security.txt:
# CONTACT_EMAIL=security@example.com

# ---------------------------------------------------------------------------
# الفواتير (اختياري — بدونه يبقى الشراء معطّلاً بأمان)
# ---------------------------------------------------------------------------
# لا تُمنح أي خطة إلا بدفعة مُتحقّقة عبر webhook موقّع. اضبط الثلاثة لتشغيل البيع:
# PAYMENT_PROVIDER=stripe
# PAYMENT_KEY=sk_live_...
# PAYMENT_WEBHOOK_SECRET=whsec_...
# قالب رابط الدفع — {plan} يُستبدل باسم الخطة:
# PAYMENT_LINK=https://buy.stripe.com/xxx?plan={plan}
# PAYMENT_CANCEL_URL=https://api.stripe.com/v1/subscriptions/cancel
# العنوان العام (لروابط العودة بعد الدفع):
# PUBLIC_URL=https://tradli.example.com

# ---------------------------------------------------------------------------
# سبوت المعادن (اختياري — مُفعّل افتراضياً بلا مفتاح)
# ---------------------------------------------------------------------------
# Yahoo يعطي العقود الآجلة (GC=F) وهي تفرق بضع دولارات عن السبوت الذي يراه
# المتداول على MT5. هذا المصدر يزوّد السعر اللحظي للذهب/الفضة، ونزحزح الشموع
# لتتطابق معه (شكل الشموع والمؤشرات لا تتغير). اتركه فارغاً للتعطيل.
# GOLD_API_URL=https://api.gold-api.com/price/{sym}
# GOLD_API_TTL=60

# ---------------------------------------------------------------------------
# لوحة المشرف (اختياري — بدونه المسار معطّل بأمان)
# ---------------------------------------------------------------------------
# رمز Bearer لمسار /api/admin/stats (قراءة فقط: مستخدمون، طلبات، إيراد).
# استخدم قيمة عشوائية طويلة. بدونها يرد المسار 503.
# ADMIN_TOKEN=change-me-to-a-long-random-token

# ---------------------------------------------------------------------------
# استقبال الإشارات (اختياري — بدونه المسار معطّل بأمان)
# ---------------------------------------------------------------------------
# رمز Bearer لمسار POST /api/signals/ingest. بدون SIGNAL_INGEST_TOKEN يرد
# المسار 503، لأن مركز الإشارات يُعرض داخل الصفحة — وكتابة إشارة من مصدر غير
# موثوق تعني كتابة وسوم في شاشة كل زائر.
# SIGNAL_INGEST_TOKEN=change-me-too

# ---------------------------------------------------------------------------
# الهوية والعلامة (اختياري)
# ---------------------------------------------------------------------------
# اسم المنتج الظاهر في الواجهة والعنوان وبريد التواصل. افتراضياً "Aurora Markets".
# BRAND_NAME=Aurora Markets
# CONTACT_EMAIL=support@example.com

# ---------------------------------------------------------------------------
# حدود موزّعة (اختياري — للإنتاج متعدد العمليات/الخوادم)
# ---------------------------------------------------------------------------
# بدونها تبقى العدّادات في الذاكرة، أي أن كل عامل gunicorn له حصّته الخاصة
# (مع -w 4 يصبح الحد الفعلي 4 أضعاف). اضبط REDIS_URL ليكون الحد مشتركاً:
# REDIS_URL=redis://localhost:6379/0
# LOG_LEVEL=INFO

