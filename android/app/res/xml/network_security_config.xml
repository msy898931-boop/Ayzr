<?xml version="1.0" encoding="utf-8"?>
<!--
  The server address is chosen by the user and may be a plain-http LAN host
  (e.g. http://192.168.1.20:8000 during testing), so cleartext is permitted.
  Ship with a TLS server in production: cleartext means the session cookie can
  be read on the wire.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
</network-security-config>
